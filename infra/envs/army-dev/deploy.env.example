# Copy to deploy.env (gitignored) — per-environment deploy settings for deploy.sh.
#
# Keeps the account ID out of the public repo: the tracked deploy.sh has no
# account-specific value; it reads EXPECTED_ACCOUNT from this local file and
# refuses to deploy if the resolved AWS account does not match.

# AWS CLI profile that authenticates to this environment's account.
AWS_PROFILE=army-govcloud

# Region for this environment.
AWS_REGION=us-gov-west-1

# The account this environment MUST deploy into. deploy.sh hard-fails on a
# mismatch (the wrong-account tripwire). Fill in the real 12-digit account id.
EXPECTED_ACCOUNT=REPLACE-with-account-id
