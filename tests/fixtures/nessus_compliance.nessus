<?xml version="1.0" ?>
<!--
  Sanitized Nessus DISA compliance scan (.nessus, NessusClientData_v2).
  Structure mirrors real Nessus Policy Compliance output (Unix Compliance
  Checks plugin 21157 with DISA STIG .audit file) — element names, cm:
  namespace tags, and compliance-reference token format verified against a
  real Tenable export. Hostnames, IPs, and values are synthetic.
-->
<NessusClientData_v2>
<Policy><policyName>Policy Compliance Auditing</policyName>
<Preferences><ServerPreferences><preference><name>plugin_set</name><value>21157</value></preference></ServerPreferences></Preferences>
</Policy>
<Report name="DISA Compliance Scan" xmlns:cm="http://www.nessus.org/cm">
<ReportHost name="192.168.77.10">
<HostProperties>
<tag name="host-ip">192.168.77.10</tag>
<tag name="host-fqdn">rhel7-lab-01.example.mil</tag>
<tag name="HOST_START">Tue Mar 15 08:00:00 2026</tag>
<tag name="HOST_END">Tue Mar 15 08:41:12 2026</tag>
</HostProperties>
<ReportItem port="0" svc_name="general" protocol="tcp" severity="3" pluginID="21157" pluginName="Unix Compliance Checks" pluginFamily="Policy Compliance">
<agent>unix</agent>
<compliance>true</compliance>
<compliance_check_type>Unix</compliance_check_type>
<fname>unix_compliance_check.nbin</fname>
<plugin_type>local</plugin_type>
<risk_factor>None</risk_factor>
<cm:compliance-benchmark-version>3.4.0</cm:compliance-benchmark-version>
<cm:compliance-check-name>RHEL-07-010010 - The Red Hat Enterprise Linux operating system must be configured so that the file permissions, ownership, and group membership of system files and commands match the vendor values.</cm:compliance-check-name>
<cm:compliance-check-id>aa11bb22cc33dd44ee55ff66aa77bb88cc99dd00ee11ff22aa33bb44cc55dd66</cm:compliance-check-id>
<cm:compliance-actual-value>Permissions of /etc/shadow: 0644 (expected 0000)</cm:compliance-actual-value>
<cm:compliance-source>custom</cm:compliance-source>
<cm:compliance-audit-file>DISA_STIG_Red_Hat_Enterprise_Linux_7_v3r4.audit</cm:compliance-audit-file>
<cm:compliance-info>Discretionary access control is weakened if a user or group has access permissions to system files and directories greater than the default.</cm:compliance-info>
<cm:compliance-result>FAILED</cm:compliance-result>
<cm:compliance-reference>800-171|3.3.8,800-53|AU-9,CAT|I,CCI|CCI-001494,DISA_Benchmark|RHEL_7_STIG,Rule-ID|SV-204392r646841_rule,STIG-ID|RHEL-07-010010,Vuln-ID|V-204392</cm:compliance-reference>
<cm:compliance-solution>Run the following command to determine which package owns the file, then reset permissions: # rpm --setperms [package]</cm:compliance-solution>
<cm:compliance-benchmark-name>DISA STIG Red Hat Enterprise Linux 7</cm:compliance-benchmark-name>
<description>"RHEL-07-010010 ..." : [FAILED]</description>
</ReportItem>
